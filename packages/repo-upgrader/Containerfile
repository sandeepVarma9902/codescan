FROM node:22-alpine

ENV NODE_ENV=production \
    MODERNIZER_PORT=8787

WORKDIR /app
COPY --chown=node:node package.json LICENSE README.md ./
COPY --chown=node:node bin ./bin
COPY --chown=node:node src ./src
COPY --chown=node:node scripts ./scripts

RUN mkdir -p /data /work && chown node:node /data /work
USER node
VOLUME ["/data", "/work"]
EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8787/readyz || exit 1

CMD ["node", "bin/repo-upgrader.js", "serve", "--host", "0.0.0.0", "--port", "8787"]

# Required bootstrap and integration secrets
MODERNIZER_API_TOKEN=replace-with-a-long-random-token
MODERNIZER_WEBHOOK_SECRET=replace-with-github-webhook-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Production persistence and distributed execution
DATABASE_URL=postgres://repo_upgrader:password@postgres:5432/repo_upgrader
REDIS_URL=redis://redis:6379
MODERNIZER_DB_SSL=disable
MODERNIZER_DB_POOL_SIZE=10
MODERNIZER_CONCURRENCY=4

# S3-compatible verification evidence
MODERNIZER_REPORT_BUCKET=
AWS_REGION=us-east-1
S3_ENDPOINT=

# Runtime isolation
MODERNIZER_ALLOWED_REPO_ROOT=/work
MODERNIZER_WORK_ROOT=/work
MODERNIZER_PORT=8787

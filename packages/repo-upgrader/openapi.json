{
  "openapi": "3.1.0",
  "info": { "title": "Repo Upgrader API", "version": "3.1.0" },
  "servers": [{ "url": "https://api.example.com" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/healthz": { "get": { "security": [], "responses": { "200": { "description": "Live" } } } },
    "/readyz": { "get": { "security": [], "responses": { "200": { "description": "Ready" }, "503": { "description": "Draining" } } } },
    "/v1/jobs": {
      "get": { "responses": { "200": { "description": "Tenant-scoped migration jobs" } } },
      "post": { "responses": { "202": { "description": "Migration queued" }, "403": { "description": "Target not included" }, "429": { "description": "Monthly or concurrency quota reached" } } }
    },
    "/v1/jobs/{id}": {
      "get": { "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "description": "Job, blockers, and resolutions" }, "404": { "description": "Not found" } } },
      "delete": { "parameters": [{ "$ref": "#/components/parameters/JobId" }], "responses": { "200": { "description": "Cancelled" } } }
    },
    "/v1/jobs/{id}/decisions": {
      "post": {
        "summary": "Approve blocker resolutions and resume a migration",
        "parameters": [{ "$ref": "#/components/parameters/JobId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "oneOf": [
          { "type": "object", "required": ["mode"], "properties": { "mode": { "const": "recommended" } } },
          { "type": "object", "required": ["resolutions"], "properties": { "resolutions": { "type": "array", "items": { "$ref": "#/components/schemas/Resolution" } } } }
        ] } } } },
        "responses": { "202": { "description": "Decisions recorded and job re-queued" }, "400": { "description": "Invalid resolution" }, "409": { "description": "Job is not awaiting a decision" } }
      }
    },
    "/v1/upload-migrations": {
      "post": {
        "summary": "Safely transform an uploaded React project",
        "parameters": [{ "name": "target", "in": "query", "schema": { "enum": ["vite", "nextjs", "react-native"] } }],
        "requestBody": { "required": true, "content": { "application/zip": {} } },
        "responses": { "200": { "description": "Migrated project ZIP" }, "413": { "description": "Plan upload, file-count, or expanded-size limit exceeded" }, "422": { "description": "No safe migration recipe" } }
      }
    },
    "/v1/usage": { "get": { "responses": { "200": { "description": "Usage, prepaid credits, and plan resource envelope" } } } },
    "/v1/analytics": { "get": { "responses": { "200": { "description": "Migration analytics" } } } },
    "/v1/integrations/github": { "get": { "responses": { "200": { "description": "Signed GitHub App installation URL" } } } },
    "/v1/billing/checkout": { "post": { "summary": "Create a server-priced Single, Team, or Business Stripe Checkout session", "responses": { "201": { "description": "Checkout URL" }, "400": { "description": "Unsupported or unconfigured plan" } } } },
    "/v1/billing/portal": { "post": { "responses": { "200": { "description": "Billing portal URL" } } } }
    ,"/v1/platform/config": { "get": { "summary": "Read platform-admin-only commercial controls", "responses": { "200": { "description": "Platform configuration" }, "403": { "description": "Platform administrator required" } } }, "patch": { "summary": "Change paid, free, invite-only, and marketing modes", "responses": { "200": { "description": "Updated platform configuration" }, "403": { "description": "Platform administrator required" } } } }
    ,"/v1/platform/readiness": { "get": { "summary": "Evaluate production launch configuration", "responses": { "200": { "description": "Launch gate and missing actions" }, "403": { "description": "Platform administrator required" } } } }
    ,"/v1/marketing/campaigns": { "get": { "summary": "List private marketing drafts", "responses": { "200": { "description": "Marketing drafts" } } }, "post": { "summary": "Create a private marketing draft", "responses": { "201": { "description": "Draft created" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } },
    "parameters": { "JobId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } },
    "schemas": { "Resolution": { "type": "object", "required": ["blockerId", "optionId"], "properties": { "blockerId": { "type": "string" }, "optionId": { "type": "string" }, "instructions": { "type": "string", "maxLength": 4000 } } } }
  }
}
